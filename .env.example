# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Your Name <you@your-verified-domain.com>
RESEND_TO_EMAIL=your-email@domain.com

# AI chat assistant (Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the default chat model
# CHAT_MODEL=claude-haiku-4-5-20251001

# Rate limiting + chat question log (Upstash Redis)
# Required in production; optional in development, where both features no-op
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
